#!/usr/bin/env bash
# visur — one command to use Visur.
#
#     visur                 edit whatever the server on :8888 already has
#     visur /path/to/file   edit that file, starting a server for it when there is no server
#
# The file you name travels with the window you are about to open — a query on the socket, /ws?open=/path — rather than
# with the server, which may have been running since morning. So `visur notes.txt` means the same thing against a fresh
# server and an old one, and a file that does not exist yet is the document you are about to write. The one thing that
# stops it is a window already editing: one document per process, so the second window is told why in its own message
# line, and `:open` is the key that works from inside a session.
#
# The server is started as `java -jar` on the fat jar, built first when a source file is newer than it. Not
# `./gradlew run`: that starts a `--redeploy` watcher, a JVM that owns no socket, outlives its client, and is invisible
# to the `lsof` this script uses to stop what it owns — fourteen on one machine at once, all of them burning CPU.
# `./gradlew run` stays the way to run a server that watches src/ and reloads; this script is the way to edit a file.
#
# Exit codes: the client's; 2 for a command line visur does not take.
#
# Uses the server already listening on :8888. If there is none it starts one and owns it, and a server it started is
# stopped again when the client exits — unless the client detached (ZZ or ZQ, exit code 0), which asks for the server
# to stay. A server that was already running is never ours to stop.
#
# VISUR_SERVER overrides how the server is started (a command line), VISUR_CLIENT overrides the client, and VISUR_LOG
# says where the server's output goes. The overrides exist so the lifecycle below can be tested without a terminal.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT=8888
OPEN_ARG="" # the file to ask for, encoded for the socket's query
CLIENT="${VISUR_CLIENT:-$ROOT/terminal/target/release/visur-term}"
LOG="${VISUR_LOG:-${TMPDIR:-/tmp}/visur-server.log}"

owned="" # the process we started, empty when the server was already running

resolve_path() { # absolute, against where the command was typed, and without needing the file to exist
  local dir base
  dir="$(dirname "$1")"
  base="$(basename "$1")"
  # `cd` and `pwd` rather than realpath, because realpath refuses a path that does not exist yet and `visur notes.txt`
  # on a file that is not written yet is the point of the whole thing. Logical pwd, so a symlinked directory stays
  # symlinked, which is what vim does to a path.
  if cd "$dir" 2>/dev/null; then
    printf '%s/%s\n' "$PWD" "$base"
  elif [[ "$1" == /* ]]; then
    printf '%s\n' "$1" # no directory to resolve against, and an absolute path needs none
  else
    printf '%s/%s\n' "$PWD" "$1"
  fi
}

# The characters that would change how a URL parses, and only those: a path is otherwise bytes, and a server that has
# to decode a query does not need a general encoder, it needs to be unable to be fooled by a space or an ampersand.
url_encode() {
  printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/?/%3F/g' -e 's/#/%23/g' -e 's/&/%26/g' -e 's/+/%2B/g'
}

# Is Visur answering? The app's own URL, not just an open port: something else could be on 8888, and the verticles
# only exist once the server can answer.
probe() { curl -sf -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/static/visur.html"; }

stop_owned() {
  [ -n "$owned" ] || return 0
  kill "$owned" 2>/dev/null
  # The port is the reliable handle on the process to end: whatever started the server may have forked it.
  local pids
  pids="$(lsof -ti "tcp:$PORT" 2>/dev/null)"
  [ -n "$pids" ] && kill $pids 2>/dev/null
  owned=""
}
trap stop_owned EXIT

build_client() {
  [ -n "${VISUR_CLIENT:-}" ] && return 0 # a substituted client needs no build
  [ -x "$CLIENT" ] || echo "building the terminal client" >&2
  ( cd "$ROOT/terminal" && cargo build --release --quiet ) || {
    echo "could not build the terminal client in $ROOT/terminal" >&2
    exit 1
  }
}

# One jar, built when a source file is newer than it: a stale jar cannot serve yesterday's editor, and starting a
# server needs no Gradle daemon in the way.
start_server() {
  if [ -n "${VISUR_SERVER:-}" ]; then
    sh -c "$VISUR_SERVER" >"$LOG" 2>&1 &
    owned=$!
    return
  fi
  local jar
  jar="$ROOT/build/libs/visur-1.0.0-SNAPSHOT-fat.jar"
  if [ ! -f "$jar" ] || [ -n "$(find "$ROOT/src" "$ROOT/build.gradle.kts" -newer "$jar" -print -quit)" ]; then
    echo "building the server jar" >&2
    ( cd "$ROOT" && ./gradlew shadowJar -q ) >&2 || return 1
  fi
  java -jar "$jar" >"$LOG" 2>&1 &
  owned=$!
}

wait_for_server() {
  for _ in $(seq 1 120); do
    probe && return 0
    kill -0 "$owned" 2>/dev/null || return 1 # the server died while we waited
    sleep 0.5
  done
  return 1
}

if [ $# -gt 1 ]; then
  echo "visur opens one file: visur /path/to/file" >&2
  exit 2
fi

case "${1:-}" in
  -*)
    # There is no --help to reach, and a flag taken for a filename is a file called "--help" sitting in the cwd,
    # openable and surprising to find there later.
    echo "visur opens one file: visur /path/to/file" >&2
    exit 2
    ;;
  '') ;;
  *)
    # Resolved here, in the directory the command was typed in: the server's cwd is whichever directory happened to
    # launch it first, so a relative path would mean one thing to the person who started the server and another to
    # whoever types the command next.
    ABS="$(resolve_path "$1")"
    OPEN_ARG="$(url_encode "$ABS")"
    ;;
esac

build_client

if probe; then
  echo "using the server already on :$PORT"
else
  echo "no server on :$PORT — starting one (log: $LOG)"
  start_server
  if ! wait_for_server; then
    echo "the server did not come up. Last lines of $LOG:" >&2
    tail -20 "$LOG" >&2
    exit 1
  fi
  echo "server ready"
fi

if [ -n "$OPEN_ARG" ]; then
  # The ask goes to the client, not to the server: it is this window that wants the file, and the server that has been
  # up for a day has no idea which window the command was typed in.
  export VISUR_WS="ws://127.0.0.1:$PORT/ws?open=$OPEN_ARG"
fi

"$CLIENT"
status=$?

if [ -n "$owned" ] && [ "$status" -eq 0 ]; then
  # Detached: the client asked for the server to stay, so hand it over rather than stopping it.
  echo "server left running on :$PORT"
  owned=""
fi
exit "$status"
